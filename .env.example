# PostgreSQL
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Interfaz donde compose publica Postgres.
# 127.0.0.1 = solo local. Poner una IP de Tailscale solo si se necesita
# alcanzar la base desde otro equipo.
DB_BIND=127.0.0.1

# API
JWT_SECRET=

# Evolution API (opcional / legado)
URL_EVOLUTION=
INSTANCE_EVOLUTION=
APIKEY_EVOLUTION=

# Alerta de fuentes muertas: numeros separados por coma.
# Vacio = el aviso queda solo en el log. No confundir con la lista de
# usuarios que reciben noticias, que vive en la tabla `usuario`.
ALERTA_WHATSAPP=
# Corridas seguidas sin resultados antes de avisar (default 3).
ALERTA_FUENTE_VACIA_CORRIDAS=
